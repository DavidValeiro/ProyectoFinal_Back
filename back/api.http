### [8/19] Crear producto
POST {{baseUrl}}/products
Content-Type: application/json

{
  "title": "Teclado mecanico MOUSIN Pro",
  "subtitle": "Switches tactiles, retroiluminacion RGB",
  "price": 129.99,
  "compareAtPrice": 159.99,
  "badge": "Nuevo",
  "category": "Perifericos / Teclados",
  "description": "Teclado mecanico de grado profesional con estructura de aluminio.",
  "rating": 4.5,
  "reviews": 128,
  "stock": 25,
  "specs": [
    { "icon": "keyboard_capslock", "label": "Switches", "value": "Tactiles" },
    { "icon": "bolt", "label": "Conexion", "value": "USB-C" }
  ],
  "image": "https://example.com/images/keyboard.jpg",
  "images": [
    "https://example.com/images/keyboard.jpg",
    "https://example.com/images/keyboard-2.jpg"
  ]
}

### -> Respuesta real (201 Created)
# HTTP/1.1 201 Created
# {
#   "title": "Teclado mecanico MOUSIN Pro",

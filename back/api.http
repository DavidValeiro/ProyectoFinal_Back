### ---------------------------------------------------------------
### PEDIDOS
### ---------------------------------------------------------------

### [12/19] Crear pedido (calcula total y descuenta stock)
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "user": "{{userId}}",
  "products": [
    { "product": "{{productId}}", "quantity": 2 }
  ],
  "orderStatus": "Pending"
}

### -> Respuesta real (201 Created). totalPrice = 119.99 × 2 = 239.98
# HTTP/1.1 201 Created
# {
#   "user": "6aca8a7dc7da16c26418fa57",
#   "products": [
#     { "product": "6aca8a7dc7da16c26418fa58", "quantity": 2, "_id": "6aca8a7ec7da16c26418fa7c" }
#   ],
#   "totalPrice": 239.98,
#   "orderStatus": "Pending",
#   "_id": "6aca8a7ec7da16c26418fa7b",
#   "createdAt": "2026-10-10T18:57:02.600Z",
#   "updatedAt": "2026-10-10T18:57:02.600Z",
#   "__v": 0
# }

### [13/19] Listar pedidos
GET {{baseUrl}}/orders

### -> Respuesta real (200 OK). Pedidos preexistentes + el de prueba; truncada:
# HTTP/1.1 200 OK
# [
#   { "_id": "6aca7730e3706dbc5d29594f", "user": { "...": "Gustavo Pruebas" }, "totalPrice": 378, "orderStatus": "Pending", ... },
#   { "_id": "6aca7730e3706dbc5d295956", "user": { "...": "David Valeiro" }, "totalPrice": 318, "orderStatus": "Shipped", ... },
#   { "_id": "6aca8a7ec7da16c26418fa7b", "user": { "...": "David Valeiro Actualizado" }, "totalPrice": 239.98, "orderStatus": "Pending", ... }
# ]

### [14/19] Obtener pedido por id (con usuario y producto poblados)
GET {{baseUrl}}/orders/{{orderId}}

### -> Respuesta real (200 OK)
# HTTP/1.1 200 OK
# {
#   "_id": "6aca8a7ec7da16c26418fa7b",
#   "user": {
#     "_id": "6aca8a7dc7da16c26418fa57",
#     "name": "David Valeiro Actualizado",
#     "email": "david+20261010185701@example.com"
#   },
#   "products": [
#     {
#       "product": { "_id": "6aca8a7dc7da16c26418fa58", "title": "Teclado mecanico MOUSIN Pro v2", "price": 119.99 },
#       "quantity": 2,
#       "_id": "6aca8a7ec7da16c26418fa7c"
#     }
#   ],
#   "totalPrice": 239.98,
#   "orderStatus": "Pending",
#   "createdAt": "2026-10-10T18:57:02.600Z",
#   "updatedAt": "2026-10-10T18:57:02.600Z",
#   "__v": 0
# }

### [15/19] Actualizar pedido (devuelve stock y lo vuelve a descontar)
PUT {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json

{
  "user": "{{userId}}",
  "products": [
    { "product": "{{productId}}", "quantity": 1 }
  ],
  "orderStatus": "Shipped"
}

### -> Respuesta real (201 Created). totalPrice = 119.99 × 1 = 119.99
# HTTP/1.1 201 Created
# {
#   "_id": "6aca8a7ec7da16c26418fa7b",
#   "user": "6aca8a7dc7da16c26418fa57",
#   "products": [
#     { "product": "6aca8a7dc7da16c26418fa58", "quantity": 1, "_id": "6aca8a7ec7da16c26418fa89" }
#   ],
#   "totalPrice": 119.99,
#   "orderStatus": "Shipped",
#   "createdAt": "2026-10-10T18:57:02.600Z",
#   "updatedAt": "2026-10-10T18:57:02.970Z",
#   "__v": 0
# }

### [16/19] Eliminar pedido (devuelve el stock)
DELETE {{baseUrl}}/orders/{{orderId}}

### -> Respuesta real (200 OK)
# HTTP/1.1 200 OK
# {"message":"Order deleted"}

### [17/19] Eliminar usuario
DELETE {{baseUrl}}/users/{{userId}}

### -> Respuesta real (200 OK)
# HTTP/1.1 200 OK
# {"message":"User deleted"}

### [18/19] Eliminar producto
DELETE {{baseUrl}}/products/{{productId}}

### -> Respuesta real (200 OK)
# HTTP/1.1 200 OK
# {"message":"Product deleted"}

